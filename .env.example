# LLM provider (optional). The pipeline runs in deterministic fallback mode
# with no LLM at all -- these are only read by an LLMProvider implementation
# you plug in yourself (src/curation/llm_provider.py). None ship in the MVP.
LLM_PROVIDER=none
LLM_API_KEY=

# Delivery channel (optional). The MVP never delivers anywhere by default;
# this is read by a future integrations/delivery_channel implementation.
DELIVERY_WEBHOOK_URL=
